# Copy to .env and fill in. Never commit .env.

# ── Application ─────────────────────────────────────────────────────────────
# development | production
APP_ENV=development
LOG_LEVEL=INFO
# Local: a SQLite file. Production: PostgreSQL, e.g. postgresql://user:password@host/db?ssl=require
DATABASE_URL=sqlite+aiosqlite:///./gira_agent.db
# Local only. In production the schema is created by `alembic upgrade head`.
AUTO_CREATE_SCHEMA=true
BUSINESS_PROFILE_PATH=config/business.yaml

# ── Booking API (the restaurant website) ────────────────────────────────────
BOOKING_API_URL=https://gira-lyart.vercel.app

# ── WhatsApp Cloud API (Meta) — see docs/whatsapp-setup.md ──────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
# Any long random string; the same value goes in Meta's webhook settings.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v23.0

# ── Claude ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=low
ANTHROPIC_REFUSAL_FALLBACK=true

# ── Admin interface ─────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Long random string: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# true when served over HTTPS
SESSION_HTTPS_ONLY=false

# ── Background work ─────────────────────────────────────────────────────────
# false if an external cron calls POST /internal/sweep instead
RUN_SCHEDULER=true
SWEEP_INTERVAL_SECONDS=60
RETENTION_HOURS=48
INTERNAL_TOKEN=
